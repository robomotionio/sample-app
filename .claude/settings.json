{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR}/.claude/hooks/app-handover-check.sh\" --session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
